<?xml version="1.0" encoding="utf-8"?>
<!--
  液态玻璃按钮背景 - 蓝灰中性色
  参照 Prismal 液态玻璃控件配方（微蓝白玻璃、高透、Fresnel 边缘光、无 gloss 高光）：
    1. 色相底：高透明度（30-40%）微蓝白渐变，相机画面透出
    2. Fresnel 顶光：极淡顶部渐变（模拟玻璃上边缘环境光）
    3. Fresnel 底光：极淡底部渐变（模拟玻璃下边缘对侧反光）
    4. 极淡描边：仅勾勒轮廓
  按压反馈由 ripple（半透明白色泛光）提供。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item android:id="@android:id/background">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#66E8EEF2"
                        android:endColor="#4DB7C6D0" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#2EFFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="90"
                        android:startColor="#14FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#24FFFFFF" />
                    <solid android:color="#00000000" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
