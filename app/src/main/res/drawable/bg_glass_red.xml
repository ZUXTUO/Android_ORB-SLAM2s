<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃按钮背景 - 橙红强调色（高透微色 + Fresnel 边缘光，无 gloss） -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item android:id="@android:id/background">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#66FFC9B8"
                        android:endColor="#4DFF8A65" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#2EFFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="90"
                        android:startColor="#14FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#24FFFFFF" />
                    <solid android:color="#00000000" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
