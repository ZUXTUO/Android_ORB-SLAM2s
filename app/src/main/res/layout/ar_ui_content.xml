<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.orb.slam2s.ui.CameraGLView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:id="@+id/my_fake_glsurface_view" />

    <com.orb.slam2s.rendering.gles.FilamentAspectSurfaceView
        android:id="@+id/ar_object_view_gles2_obj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true" />
    
    <View
        android:id="@+id/touch_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true" />

    <com.orb.slam2s.ui.JoystickView
        android:id="@+id/joystick_view"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/info_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#50000000">
        <TextView
            android:id="@+id/text_fps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#00D9FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowRadius="2"/>
        <TextView
            android:id="@+id/text_map_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#00FF88"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            android:shadowColor="#000000"
            android:shadowRadius="2"/>
    </LinearLayout>

    <include layout="@layout/floating_qr_window"
        android:id="@+id/floating_qr_window"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:gravity="end">

        <Button
            android:id="@+id/btn_group_ar"
            android:layout_width="80dp"
            android:layout_height="34dp"
            android:layout_marginBottom="4dp"
            android:text="@string/category_ar"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:shadowColor="#40000000"
            android:shadowRadius="1"
            android:shadowDy="1"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_glass_neutral"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
        <LinearLayout
            android:id="@+id/group_ar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <Button
                android:id="@+id/btn_create_ar_object"
                android:layout_width="66dp"
                android:layout_height="30dp"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="8dp"
                android:text="@string/btn_ar_object"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:shadowColor="#40000000"
                android:shadowRadius="1"
                android:shadowDy="1"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_glass_neutral"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
            <Button
                android:id="@+id/btn_3dof_cube"
                android:layout_width="66dp"
                android:layout_height="30dp"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="8dp"
                android:text="@string/btn_3dof"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:shadowColor="#40000000"
                android:shadowRadius="1"
                android:shadowDy="1"
                android:background="@drawable/bg_glass_red"
                android:textColor="#FFFFFF"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_group_map"
            android:layout_width="80dp"
            android:layout_height="34dp"
            android:layout_marginBottom="4dp"
            android:text="@string/category_map"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:shadowColor="#40000000"
            android:shadowRadius="1"
            android:shadowDy="1"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_glass_neutral"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
        <LinearLayout
            android:id="@+id/group_map"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <Button
                android:id="@+id/btn_save_map"
                android:layout_width="66dp"
                android:layout_height="30dp"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="8dp"
                android:text="@string/btn_save"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:shadowColor="#40000000"
                android:shadowRadius="1"
                android:shadowDy="1"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_glass_neutral"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
            <Button
                android:id="@+id/btn_load_map"
                android:layout_width="66dp"
                android:layout_height="30dp"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="8dp"
                android:text="@string/btn_load"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:shadowColor="#40000000"
                android:shadowRadius="1"
                android:shadowDy="1"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_glass_neutral"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
            <Button
                android:id="@+id/btn_map_list"
                android:layout_width="66dp"
                android:layout_height="30dp"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="8dp"
                android:text="@string/btn_map"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:shadowColor="#40000000"
                android:shadowRadius="1"
                android:shadowDy="1"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_glass_neutral"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_group_slam"
            android:layout_width="80dp"
            android:layout_height="34dp"
            android:layout_marginBottom="4dp"
            android:text="@string/category_slam"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:shadowColor="#40000000"
            android:shadowRadius="1"
            android:shadowDy="1"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_glass_neutral"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
        <LinearLayout
            android:id="@+id/group_slam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <Button
                android:id="@+id/btn_toggle_slam"
                android:layout_width="66dp"
                android:layout_height="30dp"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="8dp"
                android:text="@string/btn_slam"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:shadowColor="#40000000"
                android:shadowRadius="1"
                android:shadowDy="1"
                android:background="@drawable/bg_glass_green"
                android:textColor="#FFFFFF"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_group_display"
            android:layout_width="80dp"
            android:layout_height="34dp"
            android:layout_marginBottom="4dp"
            android:text="@string/category_display"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:shadowColor="#40000000"
            android:shadowRadius="1"
            android:shadowDy="1"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_glass_neutral"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
        <LinearLayout
            android:id="@+id/group_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <Button
                android:id="@+id/btn_toggle_pointcloud"
                android:layout_width="66dp"
                android:layout_height="30dp"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="8dp"
                android:text="@string/btn_point_cloud"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:shadowColor="#40000000"
                android:shadowRadius="1"
                android:shadowDy="1"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_glass_neutral"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
            <Button
                android:id="@+id/btn_start_web"
                android:layout_width="66dp"
                android:layout_height="30dp"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="8dp"
                android:text="@string/btn_web_server"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:shadowColor="#40000000"
                android:shadowRadius="1"
                android:shadowDy="1"
                android:background="@drawable/bg_glass_blue"
                android:textColor="#FFFFFF"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
